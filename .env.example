# Variables de entorno para Analista de Licitaciones - PRODUCCIÓN
# Copiar este archivo a .env y llenar los valores reales.
# Nunca subir .env a GitHub.

# Llave secreta de Flask (OBLIGATORIO en producción - generar con: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=cambiar-esta-llave-por-una-segura-en-produccion

# Llave del agente de IA (opcional; si no se provee, la app usa reglas locales de fallback)
AGENTE_IA_KEY=

# Puerto de la aplicación
FLASK_PORT=5000

# Modo debug (0 = desactivado en producción, 1 = solo desarrollo)
FLASK_DEBUG=0

# Host de la aplicación (0.0.0.0 para aceptar conexiones de red)
FLASK_HOST=0.0.0.0

# Usuario y contraseña para acceso a la app (configurar en .env, nunca subir valores reales)
APP_USUARIO=
APP_CLAVE=